; Briarhold — project settings. Gameplay numbers live in content/*.json, not here.
; Renderer: Forward+ for the desktop build; materials stay StandardMaterial3D so the Mobile
; renderer is a one-line change when the phone build comes.

config_version=5

[application]

config/name="Briarhold"
config/version="0.1.0"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Content="*res://game/autoload/content.gd"
Palette="*res://game/autoload/palette.gd"

[debug]

gdscript/warnings/exclude_addons=true
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/return_value_discarded=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input]

